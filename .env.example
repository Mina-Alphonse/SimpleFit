# ==============================================================================
# MasrFit AI - Environment Configuration (.env.example)
# Copy to .env.local for local development. NEVER commit secrets to git.
# ==============================================================================

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Database (PostgreSQL 16+ via Supabase / Neon or Local Docker with PgBouncer)
# For local Docker: postgresql://postgres:postgres@localhost:5432/masrfit
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/masrfit

# Upstash Redis (For rate limiting, autocomplete caching, and session store)
# For local Docker Redis: redis://localhost:6379
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_URL=redis://localhost:6379

# Authentication & Security (NextAuth / Supabase Auth)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_a_strong_32_byte_secret_here

# OAuth Providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_ID=
APPLE_SECRET=

# Optional: Supabase Client (if using managed Supabase Auth / Storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Observability & Monitoring (Phase 6)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
